# Hvilken backend frontenden snakker med. Standard er mock.
# mock  = fixtures i src/api/mock/, ingen backend
# live  = KA-backend gjennom Vite-proxyen
VITE_API_MODE=mock

# Bare for live. Uten VITE_-prefiks med vilje: Vite eksponerer bare
# VITE_-variabler for klientkoden, så disse to kan ikke havne i bundlen.
# Kopier denne fila til .env.local, som er gitignored, og fyll inn nøkkelen.
KA_API_URL=http://localhost:8080
KA_API_KEY=
