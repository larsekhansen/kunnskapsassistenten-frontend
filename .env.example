# Kopier denne fila til .env.local, som er gitignored, og fyll inn nøkkelen.
#
# Uten VITE_-prefiks med vilje: Vite eksponerer bare VITE_-variabler for
# klientkoden, så disse to kan ikke havne i bundlen. Dev-serveren er proxyen
# som setter X-API-Key.
KA_API_URL=http://localhost:8080
KA_API_KEY=

# VITE_API_MODE står IKKE her. Alle Vite-servere fra samme sjekkout leser den
# samme .env.local, så en live-modus lagt inn i fila slår inn for alle som
# kjører i dette treet, og ingen av dem har bedt om det. Sett den på
# kommandolinja for den ene kjøringen som skal bruke ekte backend:
#
#   VITE_API_MODE=live npm run dev
#
# Standard er mock: fixtures i src/api/mock/, ingen backend.
